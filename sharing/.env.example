# Public deployment requires your actual HTTPS frontend origin and API hostname.
# Generate a unique owner key: python -c "import secrets; print(secrets.token_urlsafe(32))"
PUNTO_OWNER_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_KEY
PUNTO_FRONTEND_ORIGINS=https://YOUR-ACCOUNT.github.io
PUNTO_ALLOWED_HOSTS=api.YOUR-DOMAIN.example
# Local development only. Never enable this for a public HTTP service.
PUNTO_ALLOW_LOCAL_HTTP=false
