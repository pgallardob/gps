<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#f5f8f7" android:fitsSystemWindows="true">
    <LinearLayout android:id="@+id/personal_panel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/native_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:visibility="gone" android:accessibilityLiveRegion="polite" />
        <WebView android:id="@+id/map" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:saveEnabled="false" android:importantForAutofill="no" />
    </LinearLayout>
    <ScrollView android:id="@+id/sharing_panel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/title" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/intro" android:paddingTop="12dp" android:paddingBottom="12dp" />
            <EditText android:id="@+id/invitation" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/link_hint" android:inputType="textPassword" android:maxLength="1024" android:singleLine="true" android:saveEnabled="false" android:importantForAutofill="no" />
            <Button android:id="@+id/verify" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/verify" />
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Compartir es opcional. Verifica una invitación solo si quieres enviar tu ubicación." android:padding="12dp" android:accessibilityLiveRegion="polite" />
            <CheckBox android:id="@+id/consent" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/consent" android:saveEnabled="false" />
            <Button android:id="@+id/start" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/start" android:enabled="false" />
            <Button android:id="@+id/stop" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/stop" android:enabled="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/privacy" android:paddingTop="16dp" />
            <Button android:id="@+id/battery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/battery" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="6dp" android:background="#ffffff">
        <Button android:id="@+id/personal_tab" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Mi mapa" android:textAllCaps="false" android:textColor="#ffffff" android:backgroundTint="#087f73" />
        <Button android:id="@+id/sharing_tab" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Compartir (opcional)" android:textAllCaps="false" android:textColor="#06685f" android:backgroundTint="#edf5f1" />
    </LinearLayout>
</LinearLayout>
